# ====================================
# Environment Configuration Example
# ====================================
# Copy this file to .env and replace all <YOUR_*> placeholders with actual values
# cp .env.example .env

# ===================================================
# 🚀 Application Settings
# ===================================================
SPRING_APPLICATION_NAME=fantasy-sport-hub
SERVER_PORT=9091
SERVER_PORT_DEV=9091

# Spring Profiles (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# ===================================================
# 🐘 PostgreSQL Configuration (Neon or other provider)
# ===================================================
# Development
DB_HOST_DEV=<YOUR_NEON_HOST>
DB_PORT_DEV=5432
DB_NAME_DEV=<YOUR_NEON_DATABASE>
DB_USERNAME_DEV=<YOUR_NEON_USERNAME>
DB_PASSWORD_DEV=<YOUR_NEON_PASSWORD>
DB_SSL_MODE_DEV=require

# Test
DB_HOST_TEST=<YOUR_TEST_DB_HOST>
DB_PORT_TEST=5432
DB_NAME_TEST=<YOUR_TEST_DB_NAME>
DB_USERNAME_TEST=<YOUR_TEST_DB_USERNAME>
DB_PASSWORD_TEST=<YOUR_TEST_DB_PASSWORD>
DB_SSL_MODE_TEST=require

# Production
DB_HOST_PRD=<YOUR_PROD_DB_HOST>
DB_PORT_PRD=5432
DB_NAME_PRD=<YOUR_PROD_DB_NAME>
DB_USERNAME_PRD=<YOUR_PROD_DB_USERNAME>
DB_PASSWORD_PRD=<YOUR_PROD_DB_PASSWORD>
DB_SSL_MODE_PRD=require

# R2DBC URLs (Reactive PostgreSQL)
# Format: r2dbc:postgresql://HOST/DATABASE?sslmode=require
DB_R2DBC_URL_DEV=r2dbc:postgresql://<YOUR_NEON_HOST>/<YOUR_NEON_DATABASE>?sslmode=require
DB_R2DBC_URL_TEST=r2dbc:postgresql://<YOUR_TEST_DB_HOST>/<YOUR_TEST_DB_NAME>?sslmode=require
DB_R2DBC_URL_PROD=r2dbc:postgresql://<YOUR_PROD_DB_HOST>/<YOUR_PROD_DB_NAME>?sslmode=require

# ===================================================
# 🍃 MongoDB Configuration
# ===================================================
# Connection (use 'localhost' for local dev, 'mongo' for Docker network)
SPRING_DATA_MONGODB_HOST=localhost
SPRING_DATA_MONGODB_PORT=27017
SPRING_DATA_MONGODB_AUTHENTICATION_DATABASE=admin
SPRING_DATA_MONGODB_AUTO_INDEX_CREATION=true

# Development (match with docker/mongodb/.env)
SPRING_DATA_MONGODB_DATABASE_DEV=fantasy_sports_hub
SPRING_DATA_MONGODB_USERNAME_DEV=root
SPRING_DATA_MONGODB_PASSWORD_DEV=<YOUR_MONGODB_PASSWORD>

# Test
SPRING_DATA_MONGODB_DATABASE_TEST=fantasy_sports_hub_test
SPRING_DATA_MONGODB_USERNAME_TEST=root
SPRING_DATA_MONGODB_PASSWORD_TEST=<YOUR_MONGODB_PASSWORD>

# Production
SPRING_DATA_MONGODB_DATABASE_PROD=fantasy_sports_hub_prod
SPRING_DATA_MONGODB_USERNAME_PROD=<YOUR_PROD_MONGODB_USERNAME>
SPRING_DATA_MONGODB_PASSWORD_PROD=<YOUR_PROD_MONGODB_PASSWORD>

# ===================================================
# 🔴 Redis Configuration
# ===================================================
# Connection (use 'localhost' for local dev, 'redis' for Docker network)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_TIMEOUT=2000
SPRING_DATA_REDIS_SSL_ENABLED=false

# ===================================================
# 📨 Kafka Configuration
# ===================================================
# Connection (use 'localhost:9092,localhost:9093,localhost:9094' for local dev)
# For Docker network: 'kafka-1:29092,kafka-2:29093,kafka-3:29094'
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094

# Consumer Configuration
SPRING_KAFKA_CONSUMER_GROUP_ID=fantasy-sport-hub-group
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
SPRING_KAFKA_CONSUMER_KEY_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
SPRING_KAFKA_CONSUMER_VALUE_DESERIALIZER=org.springframework.kafka.support.serializer.JsonDeserializer
SPRING_KAFKA_CONSUMER_PROPERTIES_TRUSTED_PACKAGES=*

# Producer Configuration
SPRING_KAFKA_PRODUCER_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
SPRING_KAFKA_PRODUCER_VALUE_SERIALIZER=org.springframework.kafka.support.serializer.JsonSerializer

# ===================================================
# 📊 EventStoreDB Configuration
# ===================================================
# Connection (use 'localhost' for local dev, 'eventstoredb' for Docker network)
EVENTSTORE_HOST=localhost
EVENTSTORE_HTTP_PORT=2113
EVENTSTORE_TCP_PORT=1113
EVENTSTORE_USERNAME=admin
EVENTSTORE_PASSWORD=<YOUR_EVENTSTORE_PASSWORD>
EVENTSTORE_TLS=false
EVENTSTORE_CONNECTION_STRING=esdb://admin:<YOUR_EVENTSTORE_PASSWORD>@localhost:2113?tls=false
EVENTSTORE_MAX_DISCOVERY_ATTEMPTS=3
EVENTSTORE_DISCOVERY_INTERVAL_MS=10000

# ===================================================
# 🔒 Security Configuration
# ===================================================
# JWT (use a secure random string, minimum 32 characters)
JWT_SECRET=<YOUR_JWT_SECRET_MIN_32_CHARS>
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=fantasy-sport-hub
JWT_ACCESS_TOKEN_DURATION=1h
JWT_REFRESH_TOKEN_DURATION=7d
JWT_PRIVATE_KEY_PATH=classpath:keys/private_key.pem
JWT_PUBLIC_KEY_PATH=classpath:keys/public_key.pem

# Argon2 Password Hashing
ARGON_ITERATIONS=3
ARGON_MEMORY=65536
ARGON_PARALLELISM=4

# ===================================================
# 🛡️ Resilience4j Configuration
# ===================================================
# Circuit Breaker
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_DEFAULT_SLIDINGWINDOWSIZE=10
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_DEFAULT_PERMITTEDNUMBEROFCALLSINHALFOPENSTATE=3
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_DEFAULT_SLIDINGWINDOWTYPE=COUNT_BASED
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_DEFAULT_MINIMUMNUMBEROFCALLS=5
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_DEFAULT_WAITDURATIONINOPENSTATE=5s
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_DEFAULT_FAILURERATETHRESHOLD=50

# Rate Limiter
RESILIENCE4J_RATELIMITER_INSTANCES_DEFAULT_LIMITFORPERIOD=100
RESILIENCE4J_RATELIMITER_INSTANCES_DEFAULT_LIMITREFRESHPERIOD=1s
RESILIENCE4J_RATELIMITER_INSTANCES_DEFAULT_TIMEOUTDURATION=5s

# ===================================================
# 📝 Setup Instructions
# ===================================================
# 1. Copy this file: cp .env.example .env
# 2. Replace all <YOUR_*> placeholders with actual values
# 3. Ensure passwords match Docker container configurations:
#    - MongoDB: fantasysport-hub-documents/docker/mongodb/.env
#    - Redis: fantasysport-hub-documents/docker/redis/.env
#    - EventStoreDB: fantasysport-hub-documents/docker/eventstoredb/.env
# 4. Start Docker containers first:
#    cd fantasysport-hub-documents/docker/network && docker-compose up -d
#    cd ../mongodb && docker-compose up -d
#    cd ../redis && docker-compose up -d
#    cd ../kafka && docker-compose up -d
#    cd ../eventstoredb && docker-compose up -d
# 5. Run the application: ./mvnw spring-boot:run
