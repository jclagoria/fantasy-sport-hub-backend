# ====================================
# Environment Configuration
# ====================================
# Copy this file to .env and update the values

# Application Settings
SPRING_APPLICATION_NAME=your-application-name  # e.g., fantasy-sport-hub
SERVER_PORT=port-number  # e.g., 8080

# Spring Profiles (dev, test, prod)
SPRING_PROFILES_ACTIVE=active-profile  # dev, test, or prod

# ========== MongoDB Configuration ==========
# Common
SPRING_DATA_MONGODB_HOST=mongodb-host  # e.g., localhost or mongodb
SPRING_DATA_MONGODB_PORT=mongodb-port  # e.g., 27017
SPRING_DATA_MONGODB_AUTHENTICATION_DATABASE=auth-db  # e.g., admin
SPRING_DATA_MONGODB_AUTO_INDEX_CREATION=true-or-false  # true or false

# Development
SPRING_DATA_MONGODB_DATABASE_DEV=dev-db-name  # e.g., fantasy_sports_hub_dev
SPRING_DATA_MONGODB_USERNAME_DEV=dev-username  # e.g., devuser
SPRING_DATA_MONGODB_PASSWORD_DEV=dev-password  # e.g., devpass

# Test
SPRING_DATA_MONGODB_DATABASE_TEST=test-db-name  # e.g., fantasy_sports_hub_test
SPRING_DATA_MONGODB_USERNAME_TEST=test-username  # e.g., testuser
SPRING_DATA_MONGODB_PASSWORD_TEST=test-password  # e.g., testpass

# Production
SPRING_DATA_MONGODB_DATABASE_PROD=prod-db-name  # e.g., fantasy_sports_hub_prod
SPRING_DATA_MONGODB_USERNAME_PROD=prod-username  # e.g., produser
SPRING_DATA_MONGODB_PASSWORD_PROD=prod-password  # e.g., strong-password-here

# ========== Redis Configuration ==========
SPRING_DATA_REDIS_HOST=redis-host  # e.g., localhost or redis
SPRING_DATA_REDIS_PORT=redis-port  # e.g., 6379
SPRING_DATA_REDIS_PASSWORD=redis-password  # Leave empty if no password
SPRING_DATA_REDIS_DATABASE=redis-db-number  # e.g., 0
SPRING_DATA_REDIS_TIMEOUT=connection-timeout-ms  # e.g., 2000
SPRING_DATA_REDIS_SSL_ENABLED=true-or-false  # true or false

# ========== Kafka Configuration ==========
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka-brokers  # e.g., localhost:9092
SPRING_KAFKA_CONSUMER_GROUP_ID=consumer-group-id  # e.g., fantasy-sport-hub-group
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=offset-reset  # earliest or latest
SPRING_KAFKA_CONSUMER_KEY_DESERIALIZER=key-deserializer-class  # e.g., org.apache.kafka.common.serialization.StringDeserializer
SPRING_KAFKA_CONSUMER_VALUE_DESERIALIZER=value-deserializer-class  # e.g., org.springframework.kafka.support.serializer.JsonDeserializer
SPRING_KAFKA_CONSUMER_PROPERTIES_TRUSTED_PACKAGES=trusted-packages  # e.g., * or com.your.package
SPRING_KAFKA_PRODUCER_KEY_SERIALIZER=key-serializer-class  # e.g., org.apache.kafka.common.serialization.StringSerializer
SPRING_KAFKA_PRODUCER_VALUE_SERIALIZER=value-serializer-class  # e.g., org.springframework.kafka.support.serializer.JsonSerializer

# ========== EventStoreDB Configuration ==========
EVENTSTORE_CONNECTION_STRING=connection-string  # e.g., esdb://username:password@host:port?tls=true
EVENTSTORE_HTTP_PORT=http-port  # e.g., 2113
EVENTSTORE_TCP_PORT=tcp-port  # e.g., 1113
EVENTSTORE_USERNAME=eventstore-username  # e.g., admin
EVENTSTORE_PASSWORD=eventstore-password  # e.g., changeit
EVENTSTORE_TLS=true-or-false  # true or false
EVENTSTORE_MAX_DISCOVERY_ATTEMPTS=discovery-attempts  # e.g., 10
EVENTSTORE_DISCOVERY_INTERVAL_MS=discovery-interval-ms  # e.g., 1000

# ========== Security ==========
JWT_SECRET=your-jwt-secret-key  # A secure random string
JWT_EXPIRATION_MS=token-expiration-ms  # e.g., 86400000 (24 hours)

# ========== Resilience4j ==========
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_DEFAULT_SLIDINGWINDOWSIZE=window-size  # e.g., 10
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_DEFAULT_PERMITTEDNUMBEROFCALLSINHALFOPENSTATE=half-open-calls  # e.g., 3
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_DEFAULT_SLIDINGWINDOWTYPE=window-type  # e.g., COUNT_BASED or TIME_BASED
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_DEFAULT_MINIMUMNUMBEROFCALLS=min-calls  # e.g., 5
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_DEFAULT_WAITDURATIONINOPENSTATE=wait-duration  # e.g., 5s
RESILIENCE4J_CIRCUITBREAKER_INSTANCES_DEFAULT_FAILURERATETHRESHOLD=failure-threshold  # e.g., 50

RESILIENCE4J_RATELIMITER_INSTANCES_DEFAULT_LIMITFORPERIOD=rate-limit  # e.g., 100
RESILIENCE4J_RATELIMITER_INSTANCES_DEFAULT_LIMITREFRESHPERIOD=refresh-period  # e.g., 1s
RESILIENCE4J_RATELIMITER_INSTANCES_DEFAULT_TIMEOUTDURATION=timeout-duration  # e.g., 5s